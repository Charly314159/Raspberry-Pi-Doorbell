#!/bin/sh
# Set the Visiophone web interface password.
set -e
if [ "$(id -u)" -ne 0 ]; then
    echo "Run it with sudo: sudo visiophone-passwd" >&2
    exit 1
fi
# The service keeps the configuration in memory: stop it so it does not overwrite the new password
running=0
systemctl is-active --quiet visiophone && running=1 && systemctl stop visiophone
cd /opt/visiophone
sudo -u visiophone PYTHONPATH=/opt/visiophone python3 -m visiophone passwd || status=$?
[ "$running" -eq 1 ] && systemctl start visiophone
exit ${status:-0}
